# Core AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Multi-provider AI router (Claude and Gemini through Vercel AI Gateway)
AI_GATEWAY_API_KEY=
ZYRON_AI_ROUTER_MODE=manual
ZYRON_AGENT_MAX_STEPS=4
ZYRON_CLAUDE_MODEL=anthropic/claude-haiku-4.5
ZYRON_GEMINI_MODEL=google/gemini-3.1-flash-lite

# Database
DATABASE_URL=

# ZYRON owner/auth
ZYRON_OWNER_KEY=
ZYRON_AUTH_SECRET=

# Google integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web push (only if push is enabled)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Public base URL for clients, e.g. https://zyron.example.com
NEXT_PUBLIC_ZYRON_BASE_URL=
